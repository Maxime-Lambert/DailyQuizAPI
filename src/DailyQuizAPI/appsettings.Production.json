{
  "Serilog": {
    "WriteTo": [
	  { "Name": "Console" },
	  {
		"Name": "File",
        "Args": {
            "path": "D:/home/LogFiles/log-.txt",
            "rollingInterval": "Day",
            "rollOnFileSizeLimit": true,
            "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
	  }
	],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}